<Project Sdk="Microsoft.NET.Sdk">

	<!-- Copied to the root of a release worktree; the ProjectReference resolves
	     against that tree's sources. Do not reference anything outside src/. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>InteropHost</AssemblyName>
		<!-- The host sits at the worktree root: the default ** glob would swallow
		     the whole release tree (including its tests). -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="InteropHost.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="src/Pinhole.Blobs/Pinhole.Blobs.csproj" />
	</ItemGroup>

</Project>
