<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<!-- v2 runner is the last line for xunit v2; bump of the SDK addresses the macOS testhost hang -->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Pinhole/Pinhole.csproj" />
		<ProjectReference Include="../../src/Pinhole.Turn/Pinhole.Turn.csproj" />
		<ProjectReference Include="../../src/Pinhole.Rendezvous/Pinhole.Rendezvous.csproj" />
	</ItemGroup>

</Project>
