<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<!-- v2 runner is the last line for xunit v2; bump of the SDK addresses the macOS testhost hang -->
	</ItemGroup>

	<ItemGroup>
		<!-- The previous-version interop host is a separate executable with its own
		     entry point and generated sources; it is built through InteropHost.csproj. -->
		<Compile Remove="Interop/**/*.cs" />
		<ProjectReference Include="../../src/Pinhole/Pinhole.csproj" />
		<ProjectReference Include="../../src/Pinhole.Blobs/Pinhole.Blobs.csproj" />
		<ProjectReference Include="../../src/Pinhole.Turn/Pinhole.Turn.csproj" />
		<ProjectReference Include="../../src/Pinhole.Rendezvous/Pinhole.Rendezvous.csproj" Condition="'$(TargetFramework)' != 'net8.0'" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<!-- The server CLI targets .NET 10. Exercise its unchanged production server
		     source alongside the .NET 8 client without retargeting the executable. -->
		<Compile Include="../../src/Pinhole.Rendezvous/RendezvousServer.cs" Link="Helpers/RendezvousServer.cs" />
	</ItemGroup>

</Project>
