<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated evaluation of the official C# API; no shipping dependency changes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- System.Net.Quic is preview on .NET 8, stable on .NET 9+. -->
    <EnablePreviewFeatures Condition="'$(TargetFramework)' == 'net8.0'">true</EnablePreviewFeatures>
    <GenerateRequiresPreviewFeaturesAttribute Condition="'$(TargetFramework)' == 'net8.0'">true</GenerateRequiresPreviewFeaturesAttribute>
  </PropertyGroup>
</Project>
