<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>Optional iroh bridge for Pinhole.Net — free rendezvous/signaling and relay fallback via n0 infrastructure</Description>
		<PackageId>Pinhole.Iroh</PackageId>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Pinhole/Pinhole.csproj" />
		<PackageReference Include="N0.IrohNet" Version="0.101.13" />
	</ItemGroup>

</Project>
