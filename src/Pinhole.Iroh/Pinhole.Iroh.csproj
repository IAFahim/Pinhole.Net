<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Description>Optional iroh bridge for Pinhole.Net — free rendezvous/signaling and relay fallback via n0 infrastructure</Description>
		<PackageId>Pinhole.Iroh</PackageId>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Pinhole/Pinhole.csproj" />
		<!-- The safe layer is not on NuGet yet; it rides in as a submodule pinned to the PR branch
		     (https://github.com/IsaMorphic/N0.IrohNet/pull/50) until it is merged and published.
		     Build the native lib once first: dotnet build extern/irohnet/N0.IrohNet.NativeAssets.Linux -f net10.0 -r linux-x64 -->
		<ProjectReference Include="../../extern/irohnet/N0.IrohNet.Safe/N0.IrohNet.Safe.csproj" />
	</ItemGroup>

</Project>
