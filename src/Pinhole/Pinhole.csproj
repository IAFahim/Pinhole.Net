<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Description>Connection library for .NET: NAT traversal over free STUN and public iroh HTTPS relays, optional TURN, connection strings, and roaming. One UDP socket, zero allocations on the direct path, no native dependencies</Description>
		<PackageId>Pinhole.Net</PackageId>
		<IsPackable>true</IsPackable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSymbols>true</IncludeSymbols>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<ProjectReference Include="..\Pinhole.Turn\Pinhole.Turn.csproj" />
		<ProjectReference Include="..\Pinhole.Providers\Pinhole.Providers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Pinhole.Tests" />
	</ItemGroup>

</Project>
