<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Description>Connection library for .NET — the bottom layer, nothing else: NAT-traversal connections over free STUN and free TURN relays, connection strings, open-forever roaming. One UDP socket, zero allocations on the hot path, no native dependencies</Description>
		<PackageId>Pinhole.Net</PackageId>
		<IsPackable>true</IsPackable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSymbols>true</IncludeSymbols>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pinhole.Turn\Pinhole.Turn.csproj" />
		<ProjectReference Include="..\Pinhole.Providers\Pinhole.Providers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Pinhole.Tests" />
	</ItemGroup>

</Project>
