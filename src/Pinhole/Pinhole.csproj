<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Description>Connection library for .NET: NAT traversal over free STUN and public iroh HTTPS relays, optional TURN, connection strings, and roaming. One UDP socket, zero allocations on the direct path, no native dependencies</Description>
		<PackageId>Pinhole.Net</PackageId>
		<IsPackable>true</IsPackable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSymbols>true</IncludeSymbols>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
			<!-- Public API contract: new or changed public surface must update
		     PublicAPI.*.txt (run: dotnet format analyzers), and breaking changes
		     (RS0017 removals/mutations) fail the build outright. -->
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<ProjectReference Include="..\Pinhole.Turn\Pinhole.Turn.csproj" />
		<ProjectReference Include="..\Pinhole.Providers\Pinhole.Providers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Pinhole.Tests" />
		<InternalsVisibleTo Include="Pinhole.Blobs" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>
</Project>
